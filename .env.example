# Admin Authentication
ADMIN_EMAIL="admin@grandeurlabs.com"
ADMIN_PASSWORD_HASH="$2a$10$w0u3L/hJ4H9dGqCqGqvU4.g7D55qMhEfe8FzF7V93qK331x35l8p2" # default: Admin@Grandeur2026!
JWT_SECRET="grandeur-luxury-hotel-secret-key-super-secure-production-2026"

# Email Notifications (Configurable: 'log' for local/preview, 'resend' or 'smtp' for production)
